# Copy this file to ".env" and fill in your Supabase project values.
# Find them in your Supabase dashboard: Project Settings > API.
# These are PUBLIC (safe to expose in the browser). Never put the service_role key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-anon-public-key
